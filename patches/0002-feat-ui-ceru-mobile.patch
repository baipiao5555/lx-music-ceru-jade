diff --git a/src/core/playlistImport.ts b/src/core/playlistImport.ts
new file mode 100644
index 0000000..e53e7a2
--- /dev/null
+++ b/src/core/playlistImport.ts
@@ -0,0 +1,126 @@
+import { getListDetail, getListDetailAll } from '@/core/songlist'
+import { createList } from '@/core/list'
+import { deduplicationList } from '@/utils'
+
+/**
+ * 歌单导入：把其他平台的歌单链接 / 分享文案 / 纯 ID 解析成本地歌单
+ *
+ * 解析拿到的歌曲是 LX 标准的 MusicInfoOnline（source 为对应平台），
+ * 播放时仍然走用户自定义源，与在线列表里的歌曲完全一致。
+ */
+
+export type PlaylistImportSource = 'wy' | 'tx' | 'kg' | 'kw' | 'mg'
+
+export interface PlaylistImportSourceInfo {
+  id: PlaylistImportSource
+  name: string
+  example: string
+}
+
+export const PLAYLIST_IMPORT_SOURCES: PlaylistImportSourceInfo[] = [
+  {
+    id: 'wy',
+    name: '网易云音乐',
+    example: 'https://music.163.com/playlist?id=3778678',
+  },
+  {
+    id: 'tx',
+    name: 'QQ 音乐',
+    example: 'https://i.y.qq.com/n2/m/share/details/taoge.html?id=7011264340',
+  },
+  {
+    id: 'kg',
+    name: '酷狗音乐',
+    example: 'https://m.kugou.com/pllist/info/3102174',
+  },
+  {
+    id: 'kw',
+    name: '酷我音乐',
+    example: 'https://m.kuwo.cn/newh5app/playlist_detail/3720681210',
+  },
+  {
+    id: 'mg',
+    name: '咪咕音乐',
+    example: 'https://music.migu.cn/v5/#/playlist?playlistId=221573417',
+  },
+]
+
+const ID_RULES: Record<PlaylistImportSource, RegExp[]> = {
+  wy: [/[?&#]id=(\d+)/i, /playlist\/(\d+)/i, /^\d+$/],
+  tx: [/[?&](?:disstid|id)=(\d+)/i, /playlist\/(\d+)/i, /^\d+$/],
+  kg: [
+    /pllist\/info\/(\d+)/i,
+    /special\/single\/(\d+)/i,
+    /[?&](?:specialid|specialId)=(\d+)/i,
+    /^\d+$/,
+  ],
+  kw: [/playlist_detail\/(\d+)/i, /[?&]pid=(\d+)/i, /playlist\/(\d+)/i, /^\d+$/],
+  mg: [/[?&](?:playlistId|id)=(\d+)/i, /playlist\/(\d+)/i, /^\d+$/],
+}
+
+/**
+ * 从链接、整段分享文案或纯 ID 中提取歌单 ID
+ */
+export const extractPlaylistId = (source: PlaylistImportSource, text: string): string => {
+  const raw = text.trim()
+  if (!raw) return ''
+  for (const rule of ID_RULES[source]) {
+    const matched = raw.match(rule)
+    if (matched) return matched[1] ?? matched[0]
+  }
+  // 分享文案里没有能识别的链接时，退化为取最长的一段数字
+  const digits = raw.match(/\d{6,}/)
+  if (digits) return digits[0]
+  // 短链（如 163cn.tv）交给各平台 SDK 自己跟随跳转解析
+  const link = raw.match(/https?:\/\/[^\s，。；、）)】\]"']+/i)
+  return link ? link[0] : ''
+}
+
+// 酷狗 SDK 只有 id_ 前缀才会按 specialid 取歌单，纯数字会被当成酷狗码
+const toSdkId = (source: PlaylistImportSource, id: string) => {
+  return source == 'kg' && /^\d+$/.test(id) ? `id_${id}` : id
+}
+
+export interface PlaylistImportResult {
+  listId: string
+  name: string
+  count: number
+}
+
+/**
+ * 解析歌单并保存为本地列表
+ */
+export const importPlaylist = async(source: PlaylistImportSource, text: string): Promise<PlaylistImportResult> => {
+  const id = extractPlaylistId(source, text)
+  if (!id) throw new Error(global.i18n.t('playlist_import_error_invalid'))
+
+  const sdkId = toSdkId(source, id)
+  let detail
+  try {
+    detail = await getListDetail(sdkId, source, 1, true)
+  } catch (err) {
+    console.warn('import playlist failed', err)
+    throw new Error(global.i18n.t('playlist_import_error_failed'))
+  }
+
+  let list = detail.list
+  if (!list.length) throw new Error(global.i18n.t('playlist_import_error_empty'))
+  if (detail.total > list.length) {
+    try {
+      // 第一页已经缓存过，这里只补拉剩下的分页
+      const all = await getListDetailAll(source, sdkId, false)
+      if (all.length) list = all
+    } catch (err) {
+      console.warn('load rest of playlist failed', err)
+    }
+  }
+  list = deduplicationList(list)
+
+  const name = (detail.info?.name ?? '').trim() ||
+    global.i18n.t('playlist_import_default_name', { id })
+  const listId = `userlist_${Date.now()}`
+  // 存 SDK 能直接再次解析的形式，列表“同步”时才能正常刷新
+  await createList({ id: listId, name, list, source, sourceListId: sdkId })
+
+  return { listId, name, count: list.length }
+}
