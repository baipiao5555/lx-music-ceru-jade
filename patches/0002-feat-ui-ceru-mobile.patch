diff --git a/src/screens/Home/Vertical/BottomNav.tsx b/src/screens/Home/Vertical/BottomNav.tsx
new file mode 100644
index 0000000..6285141
--- /dev/null
+++ b/src/screens/Home/Vertical/BottomNav.tsx
@@ -0,0 +1,62 @@
+import { memo } from 'react'
+import { View, TouchableOpacity } from 'react-native'
+
+import { Icon } from '@/components/common/Icon'
+import Text from '@/components/common/Text'
+import { useTheme } from '@/store/theme/hook'
+import { useNavActiveId } from '@/store/common/hook'
+import { setNavActiveId } from '@/core/common'
+import { useI18n } from '@/lang'
+import { createStyle } from '@/utils/tools'
+
+const TABS = [
+  { id: 'nav_songlist', icon: 'album' },
+  { id: 'nav_search', icon: 'search-2' },
+  { id: 'nav_love', icon: 'love' },
+  { id: 'nav_setting', icon: 'setting' },
+] as const
+
+export default memo(() => {
+  const theme = useTheme()
+  const activeId = useNavActiveId()
+  const t = useI18n()
+
+  return (
+    <View style={[styles.bar, { backgroundColor: theme['c-content-background'], borderTopColor: theme['c-border-background'] }]}>
+      {TABS.map(tab => {
+        const active = activeId == tab.id
+        return (
+          <TouchableOpacity
+            key={tab.id}
+            style={styles.item}
+            activeOpacity={0.7}
+            onPress={() => setNavActiveId(tab.id)}
+          >
+            <Icon name={tab.icon} size={21} color={active ? theme['c-primary'] : theme['c-font-label']} />
+            <Text style={styles.label} size={9} color={active ? theme['c-primary'] : theme['c-font-label']}>{t(tab.id)}</Text>
+          </TouchableOpacity>
+        )
+      })}
+    </View>
+  )
+})
+
+const styles = createStyle({
+  bar: {
+    height: 56,
+    paddingTop: 5,
+    paddingBottom: 4,
+    paddingHorizontal: 8,
+    borderTopWidth: 1,
+    flexDirection: 'row',
+    alignItems: 'stretch',
+  },
+  item: {
+    flex: 1,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  label: {
+    marginTop: 2,
+  },
+})
