new file mode 100644
index 0000000..46cf095
--- /dev/null
+++ b/src/components/PlaylistImportModal/index.tsx
@@ -0,0 +1,224 @@
+import { forwardRef, useImperativeHandle, useRef, useState } from 'react'
+import { ScrollView, TextInput, View } from 'react-native'
+
+import Popup, { type PopupType } from '@/components/common/Popup'
+import Button from '@/components/common/Button'
+import Text from '@/components/common/Text'
+import Loading from '@/components/common/Loading'
+import { useTheme } from '@/store/theme/hook'
+import { createStyle, toast } from '@/utils/tools'
+import { useI18n } from '@/lang'
+import { setActiveList } from '@/core/list'
+import {
+  PLAYLIST_IMPORT_SOURCES,
+  importPlaylist,
+  type PlaylistImportSource,
+} from '@/core/playlistImport'
+
+export interface PlaylistImportModalType {
+  show: () => void
+}
+
+export interface PlaylistImportModalProps {
+  onImported?: (listId: string) => void
+}
+
+export default forwardRef<PlaylistImportModalType, PlaylistImportModalProps>(({ onImported }, ref) => {
+  const t = useI18n()
+  const theme = useTheme()
+  const popupRef = useRef<PopupType>(null)
+  const [visible, setVisible] = useState(false)
+  const [source, setSource] = useState<PlaylistImportSource>('wy')
+  const [text, setText] = useState('')
+  const [importing, setImporting] = useState(false)
+  const [error, setError] = useState('')
+
+  useImperativeHandle(ref, () => ({
+    show() {
+      setError('')
+      if (visible) popupRef.current?.setVisible(true)
+      else {
+        setVisible(true)
+        requestAnimationFrame(() => {
+          popupRef.current?.setVisible(true)
+        })
+      }
+    },
+  }))
+
+  const selectedSource = PLAYLIST_IMPORT_SOURCES.find(item => item.id == source)!
+
+  const handleImport = async() => {
+    if (importing) return
+    const value = text.trim()
+    if (!value) {
+      setError(t('playlist_import_error_invalid'))
+      return
+    }
+    setImporting(true)
+    setError('')
+    try {
+      const result = await importPlaylist(source, value)
+      toast(t('playlist_import_success', { name: result.name, count: result.count }), 'long')
+      setText('')
+      popupRef.current?.setVisible(false)
+      setActiveList(result.listId)
+      onImported?.(result.listId)
+    } catch (err: any) {
+      setError(err?.message ?? t('playlist_import_error_failed'))
+    } finally {
+      setImporting(false)
+    }
+  }
+
+  return (
+    visible
+      ? <Popup
+          ref={popupRef}
+          title={t('playlist_import_title')}
+          position="bottom"
+          keyHide={!importing}
+          bgHide={!importing}
+          onHide={() => { if (!importing) setError('') }}
+        >
+          <ScrollView
+            keyboardShouldPersistTaps="handled"
+            style={{ maxHeight: '100%' }}
+            contentContainerStyle={styles.container}
+          >
+            <Text size={12} color={theme['c-font-label']} style={styles.desc}>{t('playlist_import_desc')}</Text>
+            <View style={styles.chips}>
+              {PLAYLIST_IMPORT_SOURCES.map(item => {
+                const active = item.id == source
+                return (
+                  <Button
+                    key={item.id}
+                    style={styles.chip}
+                    onPress={() => { setSource(item.id); setError('') }}
+                  >
+                    <View style={[styles.chipInner, {
+                      backgroundColor: active ? theme['c-primary'] : theme['c-primary-alpha-900'],
+                      borderColor: active ? theme['c-primary'] : theme['c-primary-alpha-700'],
+                    }]}>
+                      <Text size={12} color={active ? '#fff' : theme['c-font']}>{item.name}</Text>
+                    </View>
+                  </Button>
+                )
+              })}
+            </View>
+            <TextInput
+              value={text}
+              onChangeText={text => { setText(text); if (error) setError('') }}
+              placeholder={t('playlist_import_placeholder')}
+              placeholderTextColor={theme['c-350']}
+              multiline
+              textAlignVertical="top"
+              style={{
+                ...styles.input,
+                backgroundColor: theme['c-primary-input-background'],
+                color: theme['c-font'],
+              }}
+            />
+            <Button style={styles.example} onPress={() => setText(selectedSource.example)}>
+              <Text size={11} color={theme['c-primary-dark-200']} numberOfLines={1}>
+                {t('playlist_import_example') + '：' + selectedSource.example}
+              </Text>
+            </Button>
+            {error
+              ? <Text size={12} color="#e5484d" style={styles.error}>{error}</Text>
+              : null
+            }
+            <View style={styles.actions}>
+              <Button
+                style={[styles.actionBtn, { backgroundColor: theme['c-primary-alpha-900'], borderWidth: 1, borderColor: theme['c-primary-alpha-700'] }]}
+                onPress={() => popupRef.current?.setVisible(false)}
+                disabled={importing}
+              >
+                <Text size={13} color={theme['c-font']}>{t('playlist_import_cancel')}</Text>
+              </Button>
+              <Button
+                style={[styles.actionBtn, { backgroundColor: theme['c-primary'], marginLeft: 10 }]}
+                onPress={() => { void handleImport() }}
+                disabled={importing}
+              >
+                <View style={styles.confirmInner}>
+                  {importing
+                    ? <>
+                        <Loading size={12} color="#fff" />
+                        <Text size={13} color="#fff" style={styles.confirmText}>{t('playlist_import_importing')}</Text>
+                      </>
+                    : <Text size={13} color="#fff">{t('playlist_import_start')}</Text>
+                  }
+                </View>
+              </Button>
+            </View>
+          </ScrollView>
+        </Popup>
+      : null
+  )
+})
+
+const styles = createStyle({
+  container: {
+    paddingLeft: 14,
+    paddingRight: 14,
+    paddingBottom: 18,
+  },
+  desc: {
+    lineHeight: 18,
+    marginBottom: 12,
+  },
+  chips: {
+    flexDirection: 'row',
+    flexWrap: 'wrap',
+    marginBottom: 10,
+  },
+  chip: {
+    marginRight: 8,
+    marginBottom: 8,
+  },
+  chipInner: {
+    paddingLeft: 12,
+    paddingRight: 12,
+    paddingTop: 6,
+    paddingBottom: 6,
+    borderRadius: 999,
+    borderWidth: 1,
+  },
+  input: {
+    minHeight: 92,
+    borderRadius: 10,
+    paddingLeft: 12,
+    paddingRight: 12,
+    paddingTop: 10,
+    paddingBottom: 10,
+    fontSize: 13,
+    lineHeight: 19,
+  },
+  example: {
+    marginTop: 8,
+    marginBottom: 4,
+  },
+  error: {
+    marginTop: 8,
+    lineHeight: 18,
+  },
+  actions: {
+    flexDirection: 'row',
+    marginTop: 14,
+  },
+  actionBtn: {
+    flex: 1,
+    height: 42,
+    borderRadius: 10,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  confirmInner: {
+    flexDirection: 'row',
+    alignItems: 'center',
+  },
+  confirmText: {
+    marginLeft: 6,
+  },
+})
