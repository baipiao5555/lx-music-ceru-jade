+  const link = value.match(/https?:\/\/[^\s，。；、）)】\]"']+/i)
+  if (link) return link[0]
+  const digits = value.match(/\d{6,}/)
+  if (digits) return sourceId == 'kg' ? `id_${digits[0]}` : digits[0]
+  return value
+}
