diff --git a/src/renderer/store/list/recent.ts b/src/renderer/store/list/recent.ts
new file mode 100644
index 0000000..2906128
--- /dev/null
+++ b/src/renderer/store/list/recent.ts
@@ -0,0 +1,59 @@
+import { reactive } from '@common/utils/vueTools'
+
+const STORAGE_KEY = 'ceru.recent_play_list'
+const MAX_COUNT = 200
+
+const loadRecentList = (): LX.Music.MusicInfo[] => {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY)
+    if (!raw) return []
+    const list = JSON.parse(raw)
+    return Array.isArray(list) ? list : []
+  } catch {
+    return []
+  }
+}
+
+export const recentList = reactive<LX.Music.MusicInfo[]>(loadRecentList())
+
+const trackKey = (musicInfo: LX.Music.MusicInfo) => `${musicInfo.source}_${musicInfo.id}`
+
+let saveTimer: ReturnType<typeof setTimeout> | null = null
+const saveRecentList = () => {
+  if (saveTimer) return
+  saveTimer = setTimeout(() => {
+    saveTimer = null
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(recentList))
+    } catch {}
+  }, 300)
+}
+
+export const addRecentMusic = (musicInfo: LX.Music.MusicInfo) => {
+  if (!musicInfo?.id || !musicInfo.source) return
+  const key = trackKey(musicInfo)
+  const index = recentList.findIndex(item => trackKey(item) == key)
+  if (index > -1) {
+    if (index == 0) return
+    recentList.splice(index, 1)
+  }
+  recentList.unshift({ ...musicInfo })
+  if (recentList.length > MAX_COUNT) recentList.splice(MAX_COUNT)
+  saveRecentList()
+}
+
+export const removeRecentMusic = (ids: string[]) => {
+  const targets = new Set(ids)
+  let removed = false
+  for (let i = recentList.length - 1; i >= 0; i--) {
+    if (!targets.has(recentList[i].id)) continue
+    recentList.splice(i, 1)
+    removed = true
+  }
+  if (removed) saveRecentList()
+}
+
+export const clearRecentMusic = () => {
+  recentList.splice(0, recentList.length)
+  saveRecentList()
+}
