+@import './layout.less';
+
+/* 青瓷：浅色毛玻璃外壳 */
+html,
+body {
+  background: #dfeee8;
+}
+
+#root {
+  background: transparent !important;
+}
+
+#container {
+  background:
+    radial-gradient(90% 70% at 0% 0%, #b8f5dd 0%, rgba(184, 245, 221, 0) 55%),
+    radial-gradient(70% 60% at 100% 0%, #ffd6e0 0%, rgba(255, 214, 224, 0) 52%),
+    radial-gradient(80% 70% at 50% 110%, #d8d0ff 0%, rgba(216, 208, 255, 0) 62%),
+    linear-gradient(135deg, #eef9f4 0%, #f8f3ff 55%, #eef9f4 100%) !important;
+  padding: 0 !important;
+}
+
+#left {
+  width: 184px !important;
+  padding: 18px 10px 12px !important;
+  box-sizing: border-box !important;
+  background: transparent !important;
+}
+
+#right {
+  margin: 0 8px 8px 0 !important;
+  border-radius: 18px !important;
+  background: rgba(255, 255, 255, 0.72) !important;
+  backdrop-filter: blur(22px) !important;
+  border: 1px solid rgba(255, 255, 255, 0.72) !important;
+  box-shadow: 0 12px 40px rgba(40, 90, 70, 0.12) !important;
+  overflow: hidden !important;
+}
+
+#toolbar {
+  height: 64px !important;
+  padding: 0 16px 0 22px !important;
+  background: transparent !important;
+  border-bottom: 1px solid rgba(20, 35, 31, 0.06) !important;
+}
+
+#toolbar input {
+  width: 320px !important;
+  height: 36px !important;
+  border-radius: 99px !important;
+  background: rgba(255, 255, 255, 0.6) !important;
+  border: 1px solid rgba(255, 255, 255, 0.82) !important;
+  padding: 0 16px !important;
+  font-size: 12px !important;
+  color: #14231f !important;
+  box-shadow: 0 4px 14px rgba(40, 90, 70, 0.06) !important;
+}
+
+#view {
+  padding: 12px 20px 0 !important;
+}
+
+/* 悬浮玻璃播放条 */
+#player {
+  margin: 0 12px 12px !important;
+  height: 64px !important;
+  border-radius: 16px !important;
+  background: rgba(255, 255, 255, 0.66) !important;
+  border: 1px solid rgba(255, 255, 255, 0.86) !important;
+  box-shadow: 0 12px 30px rgba(40, 90, 70, 0.12) !important;
+  backdrop-filter: blur(18px) !important;
+}
+
+#player::before {
+  display: none !important;
+}
+
+#player > div:first-child > div {
+  border-radius: 10px !important;
+  background: linear-gradient(135deg, #71f0cf, #16b89b) !important;
+  color: #06251f !important;
+  font-weight: 800 !important;
+}
+
+#player img {
+  border-radius: 10px !important;
+}
+
+#player [aria-label="播放"],
+#player [aria-label="暂停"] {
+  width: 34px !important;
+  height: 34px !important;
+  border-radius: 50% !important;
+  background: #16b89b !important;
+  color: #fff !important;
+  padding: 8px !important;
+  box-shadow: 0 6px 16px rgba(22, 184, 155, 0.28) !important;
+}
+
+/* 顶部内容里的来源/类型 tab 统一成胶囊 */
+#view ul[role="tablist"] {
+  gap: 8px !important;
+  align-items: center !important;
+}
+
+#view li[role="tab"] {
+  border-radius: 99px !important;
+  padding: 0 12px !important;
+  height: 30px !important;
+  background: rgba(255, 255, 255, 0.6) !important;
+  border: 1px solid rgba(20, 35, 31, 0.06) !important;
+}
+
+#view li[role="tab"][aria-selected="true"] {
+  background: #16b89b !important;
+  color: #fff !important;
+  border-color: transparent !important;
+}
+
+#view li[role="tab"] span {
+  font-size: 12px !important;
+}
+
+/* 侧栏导航兜底样式（组件内也会同步改） */
+#left a[role="tab"] {
+  border-radius: 10px !important;
+  color: #5f726b !important;
+}
+
+#left a[aria-selected="true"] {
+  background: #16b89b !important;
+  color: #fff !important;
+  box-shadow: 0 8px 18px rgba(22, 184, 155, 0.24) !important;
+}
+
+#left a[aria-selected="true"] svg {
+  color: #fff !important;
+}
+
+#toolbar input ~ button {
+  background: transparent !important;
+  border: 0 !important;
+  color: var(--color-font-label) !important;
+  box-shadow: none !important;
+}
+
+#toolbar input ~ button:hover {
+  color: var(--color-primary) !important;
+}
+
+/* 播放详情页：黑胶 + 玻璃歌词 */
+.ceru-play-detail {
+  background:
+    radial-gradient(80% 70% at 0% 0%, #b8f5dd 0%, rgba(184, 245, 221, 0) 55%),
+    radial-gradient(70% 60% at 100% 0%, #ffd6e0 0%, rgba(255, 214, 224, 0) 52%),
+    radial-gradient(80% 70% at 50% 110%, #d8d0ff 0%, rgba(216, 208, 255, 0) 62%),
+    linear-gradient(135deg, #eef9f4 0%, #f8f3ff 55%, #eef9f4 100%) !important;
+  border-radius: 18px !important;
+}
+
+.ceru-play-detail .bg {
+  display: none !important;
+}
+
+.ceru-play-left {
+  padding: 44px 20px 12px !important;
+}
+
+.ceru-play-left .info {
+  position: relative;
+  align-items: center;
+  max-width: 340px;
+  overflow: visible !important;
+}
+
+.ceru-play-left .info::before {
+  content: "";
+  position: absolute;
+  z-index: 0;
+  width: 320px;
+  height: 320px;
+  border-radius: 50%;
+  top: -35px;
+  left: 50%;
+  transform: translateX(-50%);
+  background: repeating-radial-gradient(circle at 50% 50%, #0b0b0b 0 2px, #1a1a1a 2px 4px);
+  box-shadow: 0 30px 60px rgba(0, 0, 0, .28), inset 0 0 0 1px rgba(255, 255, 255, .08);
+}
+
+.ceru-play-left .info::after {
+  content: "";
+  position: absolute;
+  z-index: 2;
+  width: 120px;
+  height: 6px;
+  border-radius: 99px;
+  top: 8px;
+  left: 58%;
+  transform-origin: right center;
+  transform: rotate(-28deg);
+  background: linear-gradient(90deg, #cfcfcf, #f6f6f6);
+  box-shadow: 0 4px 10px rgba(0, 0, 0, .25);
+}
+
+.ceru-play-left .img {
+  position: relative;
+  z-index: 1;
+  width: 250px !important;
+  height: 250px !important;
+  max-width: none !important;
+  max-height: none !important;
+  min-width: 0 !important;
+  object-fit: cover;
+  border-radius: 50% !important;
+  opacity: 1 !important;
+  box-shadow: 0 20px 50px rgba(0, 0, 0, .3) !important;
+}
+
+.ceru-play-left .description {
+  position: relative;
+  z-index: 1;
+  max-width: 340px;
+  margin-top: 46px;
+  text-align: center;
+  padding-bottom: 8px;
+}
+
+.ceru-play-left .description p {
+  font-size: 12px !important;
+  line-height: 1.6;
+  color: var(--color-font-label);
+}
+
+.ceru-play-left .description p:first-child {
+  font-size: 16px !important;
+  font-weight: 600;
+  color: var(--color-font);
+}
+
+.ceru-play-detail .right {
+  background: rgba(255, 255, 255, .55) !important;
+  border: 1px solid rgba(255, 255, 255, .75);
+  border-radius: 20px;
+  margin: 12px 6px 12px 0;
+  padding: 18px 16px;
+  backdrop-filter: blur(20px);
+  box-shadow: 0 12px 30px rgba(40, 90, 70, .08);
+  overflow: hidden;
+}
