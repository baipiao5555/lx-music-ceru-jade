+@import './layout.less';
+
+/* 青瓷夜色：深色卡片外壳（Alger 风格参考） */
+html,
+body {
+  background: #0b0d10;
+}
+
+#root {
+  background: transparent !important;
+}
+
+#container {
+  background:
+    radial-gradient(900px 420px at 6% -12%, rgba(16, 185, 129, .20), rgba(16, 185, 129, 0) 62%),
+    radial-gradient(820px 400px at 102% -6%, rgba(59, 130, 246, .15), rgba(59, 130, 246, 0) 58%),
+    #0b0d10 !important;
+  padding: 0 !important;
+}
+
+#left {
+  width: 76px !important;
+  padding: 0 0 10px !important;
+  box-sizing: border-box !important;
+  background: rgba(13, 16, 20, .92) !important;
+  border-right: 1px solid rgba(255, 255, 255, .06);
+}
+
+#right {
+  margin: 0 !important;
+  border-radius: 0 !important;
+  background: transparent !important;
+  backdrop-filter: none !important;
+  border: none !important;
+  box-shadow: none !important;
+  overflow: hidden !important;
+}
+
+#toolbar {
+  height: 64px !important;
+  padding: 0 14px 0 22px !important;
+  background: transparent !important;
+  border-bottom: none !important;
+}
+
+#toolbar input {
+  width: 100% !important;
+  height: 38px !important;
+  border-radius: 12px !important;
+  background: rgba(255, 255, 255, .06) !important;
+  border: 1px solid rgba(255, 255, 255, .08) !important;
+  padding: 0 14px !important;
+  font-size: 12px !important;
+  color: #e2e8f0 !important;
+  box-shadow: none !important;
+}
+
+#toolbar input::placeholder {
+  color: rgba(226, 232, 240, .42) !important;
+}
+
+#toolbar input ~ button {
+  background: transparent !important;
+  border: 0 !important;
+  color: rgba(226, 232, 240, .55) !important;
+  box-shadow: none !important;
+}
+
+#toolbar input ~ button:hover {
+  color: var(--color-primary) !important;
+}
+
+#view {
+  padding: 0 26px 0 !important;
+  background: transparent !important;
+}
+
+/* 贴底播放条 */
+#player {
+  margin: 0 !important;
+  height: 76px !important;
+  border-radius: 0 !important;
+  background: rgba(12, 15, 19, .94) !important;
+  border: none !important;
+  border-top: 1px solid rgba(255, 255, 255, .07) !important;
+  box-shadow: 0 -10px 30px rgba(0, 0, 0, .35) !important;
+  backdrop-filter: blur(18px) !important;
+}
+
+#player::before {
+  display: none !important;
+}
+
+#player img {
+  border-radius: 12px !important;
+  box-shadow: 0 8px 20px rgba(0, 0, 0, .4) !important;
+}
+
+#player [aria-label="播放"],
+#player [aria-label="暂停"] {
+  width: 36px !important;
+  height: 36px !important;
+  border-radius: 50% !important;
+  background: linear-gradient(140deg, #6ee7b7, #10b981) !important;
+  color: #052e22 !important;
+  padding: 8px !important;
+  box-shadow: 0 8px 20px rgba(16, 185, 129, .38) !important;
+}
+
+/* 顶部内容里的来源 / 类型 tab 统一成胶囊 */
+#view ul[role="tablist"] {
+  gap: 8px !important;
+  align-items: center !important;
+}
+
+#view li[role="tab"] {
+  border-radius: 99px !important;
+  padding: 0 12px !important;
+  height: 30px !important;
+  background: rgba(255, 255, 255, .05) !important;
+  border: 1px solid rgba(255, 255, 255, .08) !important;
+}
+
+#view li[role="tab"][aria-selected="true"] {
+  background: var(--color-primary) !important;
+  color: #04140e !important;
+  border-color: transparent !important;
+  font-weight: 600 !important;
+}
+
+#view li[role="tab"] span {
+  font-size: 12px !important;
+}
+
+/* 侧栏导航兜底样式（组件内也会同步改） */
+#left a[role="tab"] {
+  color: rgba(226, 232, 240, .55) !important;
+}
+
+#left a[aria-selected="true"] {
+  color: var(--color-primary) !important;
+  background: rgba(52, 211, 153, .16) !important;
+  box-shadow: inset 0 0 0 1px rgba(52, 211, 153, .35) !important;
+}
+
+/* 播放详情页：深色渐变 + 玻璃歌词 */
+.ceru-play-detail {
+  background:
+    radial-gradient(80% 70% at 0% 0%, rgba(16, 185, 129, .22) 0%, rgba(16, 185, 129, 0) 55%),
+    radial-gradient(70% 60% at 100% 0%, rgba(244, 114, 182, .16) 0%, rgba(244, 114, 182, 0) 52%),
+    radial-gradient(80% 70% at 50% 110%, rgba(99, 102, 241, .20) 0%, rgba(99, 102, 241, 0) 62%),
+    linear-gradient(135deg, #0c1014 0%, #10161c 55%, #0c1014 100%) !important;
+  border-radius: 18px !important;
+}
+
+.ceru-play-detail .bg {
+  display: none !important;
+}
+
+.ceru-play-left {
+  padding: 44px 20px 12px !important;
+}
+
+.ceru-play-left .info {
+  position: relative;
+  align-items: center;
+  max-width: 340px;
+  overflow: visible !important;
+}
+
+.ceru-play-left .info::before {
+  content: "";
+  position: absolute;
+  z-index: 0;
+  width: 320px;
+  height: 320px;
+  border-radius: 50%;
+  top: -35px;
+  left: 50%;
+  transform: translateX(-50%);
+  background: repeating-radial-gradient(circle at 50% 50%, #0b0b0b 0 2px, #1a1a1a 2px 4px);
+  box-shadow: 0 30px 60px rgba(0, 0, 0, .5), inset 0 0 0 1px rgba(255, 255, 255, .08);
+}
+
+.ceru-play-left .info::after {
+  content: "";
+  position: absolute;
+  z-index: 2;
